src/generated/resources/.cache
src/generated/resources/assets/hbm_m/blockstates/
src/generated/resources/assets/hbm_m/models/
src/generated/resources/data/
AGENTS.md
*.diff
/plans
/plans
.cursorignore
build-logic/build
build-logic/.gradle
build-logic/build
versions/*/build
versions/*/.gradle
versions/*/run
versions/*/.eclipse
versions/*/runGameTest
versions/datagen/
legacy/forgegradle/.gradle
legacy/forgegradle/build

# ================= Logs & Temporary Files =================
# Логи, дампы ошибок и временные файлы.
*.log
hs_err_pid*
replay_pid*
temp/
logs/
/ExampleProject/
/OLD/
agent
ideas
libs/*
design.md
# ================= OS Specific =================
# Системные файлы, которые могут случайно появиться.
.DS_Store
Thumbs.db
.kilocode

# ================= Minecraft/Forge Specific =================
# Файлы, генерируемые средой разработки Forge.
natives/
*.srg
*.tsrg
forge*changelog.txt
.fake
.editorconfig
.github/copilot-instructions.md
.gitignore
.cursor/
desktop.ini
HBM-Modernized.code-workspace
java_pid*
AGENTS.md
libs/*
# ...except the 35 KB Sable companion API jar: SubLevelAssembleExpansionMixin names
# BoundingBox3ic from it, so the build needs it present.
!libs/sable-companion-common-1.21.1-1.6.0.jar
.aider*
# Локальный контекст для Claude Code
CLAUDE.md

# Датаген пишет в assets только blockstates, models и lang. Первые два игнорируются выше,
# lang отслеживается намеренно (его забирают переводчики), а всё остальное, что провайдеры
# сгенерируют в будущем, в репозиторий попадать не должно.
src/generated/resources/assets/*
!src/generated/resources/assets/hbm_m/
src/generated/resources/assets/hbm_m/*
!src/generated/resources/assets/hbm_m/lang/

# Черновики и следы инструментов: nul появляется от перенаправления вывода в git bash,
# остальное — резервные копии редакторов и хвосты неудачных патчей.
nul
NUL
*.bak
*.orig
*.rej
*.tmp
scratch/
notes/
