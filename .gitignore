# Локальный контекст для Claude Code
CLAUDE.md

# Датаген пишет в assets только blockstates, models и lang. Первые два игнорируются выше,
# lang отслеживается намеренно (его забирают переводчики), а всё остальное, что провайдеры
# сгенерируют в будущем, в репозиторий попадать не должно.
src/generated/resources/assets/*
!src/generated/resources/assets/hbm_m/
src/generated/resources/assets/hbm_m/*
!src/generated/resources/assets/hbm_m/lang/

# Черновики и следы инструментов: nul появляется от перенаправления вывода в git bash,
# остальное — резервные копии редакторов и хвосты неудачных патчей.
nul
NUL
*.bak
*.orig
*.rej
*.tmp
scratch/
notes/

# Python bytecode
__pycache__/
*.pyc

# ================= Workflow reports (local working journal) =================
# Рабочие отчёты воркфлоу-аудитов не коммитятся; справочные доки в docs/render
# (crankshaft study, engine architecture, cpu audit 09-25) удержаны negation'ом.
docs/render/*
!docs/render/crankshaft_nucleus_comparative_study.md
!docs/render/crankshaft_nucleus_comparative_study_ru.md
!docs/render/nucleus_cpu_audit_2026-09-25.md
!docs/render/nucleus_engine_architecture.md
docs/audit/
docs/replay/
docs/weekly_report_*.md
docs/ntm_upstream_week*.md
build_out_*.txt

