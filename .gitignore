# ================= Gradle & Build Artifacts =================
# Эти файлы создаются при сборке и не должны быть в репозитории.
/build/
/.gradle/
/run/
/run-data/

# ================= IDE Specific =================
# Файлы настроек для разных сред разработки.
# Они специфичны для каждого пользователя и не должны быть общими.

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
bin/

# Visual Studio Code
.vscode/
.cursor
.cursorignore
.zcode
.roo
.rooignore
.claudeignore
opencode.json
