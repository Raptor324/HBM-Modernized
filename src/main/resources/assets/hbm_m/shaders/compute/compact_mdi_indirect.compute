#version 430

// Zeros instanceCount in DrawElementsIndirectCommand (32-byte stride per command).
// Prefer per-instance CPU/GPU filter in MdiBatchCoordinator — this shader is only
// valid when one command maps to one cull entry.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer IndirectBuffer {
    uint data[];
} uIndirect;

layout(std430, binding = 1) readonly buffer VisibilityBits {
    uint visibleBits[];
} uVisible;

layout(std430, binding = 2) readonly buffer CmdCullMap {
    uint cullIndex[];
} uCullMap;

layout(std140, binding = 0) uniform CompactParams {
    uint cmdCount;
    uint cullEntryCount;
    uint cmdStrideUints; // 8 for 32-byte commands
    uint _pad0;
} uParams;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uParams.cmdCount) return;

    uint cullIdx = uCullMap.cullIndex[i];
    if (cullIdx == 0xFFFFFFFFu) return;
    if (cullIdx >= uParams.cullEntryCount) return;

    uint word = cullIdx >> 5u;
    uint bit = cullIdx & 31u;
    if ((uVisible.visibleBits[word] & (1u << bit)) != 0u) return;

    uint base = i * uParams.cmdStrideUints;
    // DrawElementsIndirectCommand: [0]=count [1]=instanceCount
    uIndirect.data[base + 1u] = 0u;
}
